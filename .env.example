# رقيب — إعدادات التشغيل. انسخ هذا الملف إلى ".env" بجانب Raqeeb.exe (أو إلى %APPDATA%\Raqeeb\.env).
# لا ترفع ملف .env إلى GitHub: فيه أسرار.

# عنوان خادم الويب الذي يمرّر الأوامر بين الجوال وهذا الجهاز (بلا / في النهاية)
RAQEEB_RELAY_URL=https://your-relay.example.com

# السرّ الرئيسي (32 بايت = 64 حرف hex). منه يُشتق مفتاح التشفير ورمز دخول الخادم، وهو ما يُنقل إلى الجوال عبر رابط الاقتران
# (Raqeeb.exe --pair أو قائمة الصينية). يُولَّد تلقائياً أول تشغيل. لا تشاركه ولا ترفعه.
RAQEEB_SECRET=

# (اختياري، للتوافق مع لوحة التحكم) بدل السرّ الرئيسي: رمز الدخول ومفتاح التشفير مباشرة
RAQEEB_WEB_TOKEN=
RAQEEB_AGENT_KEY=

# رمز PIN لكل إجراء (4 خانات فأكثر؛ 6 موصى بها). بلا PIN تُرفض كل الإجراءات وتبقى القراءة فقط.
RAQEEB_PIN=

# اسم الجهاز على الجوال (افتراضي: اسم الجهاز) ومعرّفه (افتراضي: مشتق تلقائياً)
RAQEEB_DEVICE_NAME=
RAQEEB_DEVICE_ID=

# ---- الصلاحيات (true/false) ----
RAQEEB_ENABLED=true
RAQEEB_ALLOW_ACTIONS=true
RAQEEB_ALLOW_SCREENSHOT=true
RAQEEB_ALLOW_INPUT=true
RAQEEB_ALLOW_FILES=true
RAQEEB_ALLOW_UNLOCK=false
RAQEEB_ALLOW_SHELL=false

# مجلدات الملفات المسموحة مفصولة بـ ; (فارغ = سطح المكتب، المستندات، التنزيلات، الصور، الفيديو، الموسيقى)
RAQEEB_FILE_ROOTS=

# ---- أخرى ----
RAQEEB_NOTIFY_TELEGRAM=true
RAQEEB_OUTBOX=false
RAQEEB_AWAKE_REMINDER_MIN=30
RAQEEB_AWAKE_MAX_HOURS=8
RAQEEB_AUTOSTART=false
